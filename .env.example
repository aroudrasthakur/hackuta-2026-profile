# Copy to .env.local for local development.

VITE_CONVEX_URL=https://standing-manatee-425.convex.cloud
VITE_CONVEX_SITE_URL=https://standing-manatee-425.convex.site

VITE_LANDING_URL=http://localhost:5173
VITE_REGISTER_URL=http://localhost:5273

CONVEX_DEPLOYMENT=dev:standing-manatee-425

VITE_USE_MOCK_API=false

# Server-side Convex environment variables for Apple Wallet pass signing (set via `npx convex env set`):
# APPLE_PASS_TYPE_IDENTIFIER=pass.org.hackuta.checkin
# APPLE_TEAM_IDENTIFIER=YOUR_10_CHAR_TEAM_ID
# APPLE_PASS_SIGNER_CERT_PEM=<PEM or base64-encoded Pass Type ID certificate>
# APPLE_PASS_SIGNER_KEY_PEM=<PEM or base64-encoded Pass Type ID private key>
# APPLE_PASS_SIGNER_KEY_PASSPHRASE=<optional private key passphrase>
# APPLE_WWDR_CERT_PEM=<PEM or base64-encoded Apple WWDR G4 certificate>

