# Copy to .env.local for local development.

VITE_CONVEX_URL=https://standing-manatee-425.convex.cloud
VITE_CONVEX_SITE_URL=https://standing-manatee-425.convex.site

VITE_LANDING_URL=http://localhost:5173
VITE_REGISTER_URL=http://localhost:5273

CONVEX_DEPLOYMENT=dev:standing-manatee-425

VITE_USE_MOCK_API=false

# Server-side Convex environment for Apple Wallet (set via `npx convex env set` in this repo).
# Never put these in VITE_* — the browser must not call the wallet service.
# WALLET_SERVICE_URL=https://wallet.example.com
# WALLET_SERVICE_API_KEY=<same 32+ character secret as the wallet service>

