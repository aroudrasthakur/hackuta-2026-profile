{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": [
      "ES2021",
      "dom"
    ],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*",
    "../shared/**/*"
  ],
  "exclude": [
    "./_generated"
  ]
}
