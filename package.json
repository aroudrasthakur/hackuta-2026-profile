{
  "name": "hackuta-2026-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-pdf-assets.mjs && node scripts/ensure-convex-server-stub.mjs && node scripts/verify-production-env.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "node scripts/ensure-convex-server-stub.mjs",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "lint": "eslint src convex scripts tests security",
    "pretest:unit": "node scripts/ensure-convex-server-stub.mjs",
    "test:unit": "vitest run",
    "pretest:coverage": "node scripts/ensure-convex-server-stub.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:whitespace": "node scripts/check-whitespace.mjs",
    "verify:register-schema-lock": "node scripts/verify-register-schema-lock.mjs",
    "verify:admin-schema-lock": "node scripts/verify-admin-schema-lock.mjs",
    "register-schema-lock:refresh": "node scripts/refresh-register-schema-lock.mjs",
    "admin-schema-lock:refresh": "node scripts/refresh-admin-schema-lock.mjs",
    "preconvex:push-dev": "node scripts/verify-register-schema-lock.mjs && node scripts/verify-admin-schema-lock.mjs",
    "preconvex:deploy": "node scripts/verify-register-schema-lock.mjs && node scripts/verify-admin-schema-lock.mjs",
    "convex:dev": "convex dev",
    "convex:push-dev": "convex dev --once --env-file .env.example",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@paper-design/shaders-react": "^0.0.80",
    "convex": "^1.45.0",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "convex-test": "^0.0.58",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
